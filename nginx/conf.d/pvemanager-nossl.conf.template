# NGINX Configuration Template for Server Panel (HTTP only, no SSL)
# Replace DOMAIN_NAME with your actual domain or server IP

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN_NAME;

    # Logging
    access_log /var/log/nginx/pvemanager_access.log;
    error_log /var/log/nginx/pvemanager_error.log;

    # Let's Encrypt challenge (needed for SSL certificate obtaining)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Rate limiting
    limit_req zone=general burst=20 nodelay;
    limit_conn addr 10;

    # Health check endpoint
    location /health {
        proxy_pass http://pvemanager-app:8000;
        access_log off;
    }

    # API proxy
    location /api/ {
        limit_req zone=api burst=50 nodelay;
        proxy_pass http://pvemanager-app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxmox API proxy
    location /proxmox/ {
        proxy_pass http://pvemanager-app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Загрузка ISO/образов: файлы многогигабайтные, дефолтный
        # client_max_body_size 100M и короткие таймауты им не подходят.
        client_max_body_size 20g;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_body_timeout 3600s;
    }

    # WebSocket support — tasks и terminal
    location ~ ^/(ws|proxmox/ws)/ {
        proxy_pass http://pvemanager-app:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Backend static files (legacy, logo, etc.)
    location /static/ {
        proxy_pass http://pvemanager-app:8000;
        proxy_cache_valid 200 1d;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    # SPA frontend — all other routes
    location / {
        proxy_pass http://pvemanager-frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
